# ============================================================
# JOL Commerce Engine — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# NEVER log or print secret values at runtime.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=                         # 64-char random hex; rotate every 90 days
APP_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/jol_commerce

# ── Stripe ───────────────────────────────────────────────────
# Use test keys ONLY in development. Live keys go in secrets manager.
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXX

# ── TLS ──────────────────────────────────────────────────────
TLS_MIN_VERSION=1.2
TLS_CERT_PATH=
TLS_KEY_PATH=

# ── Audit / SIEM ────────────────────────────────────────────
AUDIT_LOG_DESTINATION=file              # file | s3 | siem_endpoint
AUDIT_LOG_RETENTION_MONTHS=12
AUDIT_LOG_SEARCHABLE_MONTHS=3

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
