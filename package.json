{
  "name": "jol-commerce-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "JOL Commerce Engine — PCI DSS SAQ A compliant frontend",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
